{
  "version": "7.2",
  "data_api_version": "3.0",
  "routing_model": {
    "PHOTOS": [
      "DONE"
    ],
    "DONE": []
  },
  "screens": [
    {
      "id": "PHOTOS",
      "title": "صور البطاقة",
      "terminal": false,
      "data": {
        "error": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "f",
            "children": [
              {
                "type": "TextHeading",
                "text": "صور البطاقة الشخصية"
              },
              {
                "type": "TextBody",
                "text": "ارفع صورة وش البطاقة وصورة ضهر البطاقة. الصور هتوصل لفريقنا للمراجعة فقط ولن تُخزَّن في قاعدة البيانات."
              },
              {
                "type": "TextBody",
                "text": "${data.error}"
              },
              {
                "type": "PhotoPicker",
                "name": "id_photos",
                "label": "📸 صور البطاقة",
                "description": "ارفع صورة واضحة للوش وصورة واضحة للضهر",
                "photo-source": "camera_gallery",
                "min-uploaded-photos": 2,
                "max-uploaded-photos": 2
              },
              {
                "type": "Footer",
                "label": "إرسال الصور",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "op": "submit_photos",
                    "id_photos": "${form.id_photos}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "DONE",
      "title": "تم",
      "terminal": true,
      "data": {
        "message": {
          "type": "string",
          "__example__": "تم استلام الصور."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Image",
            "src": "https://wts-pay-1.pages.dev/success.png",
            "height": 120,
            "scale-type": "contain",
            "aspect-ratio": 1
          },
          {
            "type": "Image",
            "src": "https://wts-pay-1.pages.dev/success.png",
            "height": 120,
            "scale-type": "contain",
            "aspect-ratio": 1
          },
          {
            "type": "TextHeading",
            "text": "✅ تم استلام الصور"
          },
          {
            "type": "TextBody",
            "text": "${data.message}"
          },
          {
            "type": "Footer",
            "label": "إغلاق",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}