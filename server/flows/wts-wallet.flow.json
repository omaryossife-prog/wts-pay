    {
      "id": "HOME",
      "title": "محفظة WTS",
      "terminal": false,
      "data": {
        "balance_label": {
          "type": "string",
          "__example__": "1,200 جنيه"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "f",
            "children": [
              {
                "type": "TextHeading",
                "text": "محفظة WTS"
              },
              {
                "type": "TextBody",
                "text": "رصيدك الحالي: ${data.balance_label}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "choice",
                "label": "اختر قسم",
                "required": true,
                "data-source": [
                  {
                    "id": "transfers",
                    "title": "💸 التحويلات والمعاملات",
                    "description": "تحويل، طلب أموال، الرصيد، كشف الحساب"
                  },
                  {
                    "id": "account",
                    "title": "👤 الحساب والخدمات",
                    "description": "بياناتي، الإحالات، الإعدادات، الدعم"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "فتح",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "op": "home_open",
                    "choice": "${form.choice}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
