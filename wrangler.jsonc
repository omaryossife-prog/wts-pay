{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wts-pay-api",
  "main": "server/src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js"
      ]
    }
  ]
}
