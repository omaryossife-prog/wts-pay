{
  "version": "7.2",
  "data_api_version": "3.0",
  "screens": [
    {
      "id": "SELECT_ACTION",
      "title": "WTS Pay",
      "terminal": false,
      "data": {
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "SEND_MONEY",
              "title": "إرسال أموال",
              "description": "تحويل إلى مستخدم WTS"
            },
            {
              "id": "GET_BALANCE",
              "title": "الرصيد",
              "description": "عرض الرصيد الحالي"
            }
          ]
        },
        "message": {
          "type": "string",
          "__example__": "اختر العملية المطلوبة"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "select_action_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "WTS Pay"
              },
              {
                "type": "TextBody",
                "text": "${data.message}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "wts_action",
                "label": "العملية",
                "required": true,
                "data-source": "${data.actions}"
              },
              {
                "type": "Footer",
                "label": "متابعة",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "wts_action": "${form.wts_action}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "RECIPIENT",
      "title": "إرسال أموال",
      "terminal": false,
      "data": {
        "message": {
          "type": "string",
          "__example__": "أدخل رقم هاتف المستلم مع كود الدولة"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "recipient_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "إرسال أموال"
              },
              {
                "type": "TextBody",
                "text": "${data.message}"
              },
              {
                "type": "TextInput",
                "name": "recipient_phone",
                "label": "رقم المستلم",
                "required": true,
                "helper-text": "مثال: +2010xxxxxxx"
              },
              {
                "type": "Footer",
                "label": "متابعة",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "recipient_phone": "${form.recipient_phone}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "AMOUNT",
      "title": "المبلغ",
      "terminal": false,
      "data": {
        "recipient_phone": {
          "type": "string",
          "__example__": "+2010xxxxxxx"
        },
        "recipient_label": {
          "type": "string",
          "__example__": "Ahmed (WTS-000123)"
        },
        "message": {
          "type": "string",
          "__example__": "إرسال إلى Ahmed"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "amount_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "أدخل المبلغ"
              },
              {
                "type": "TextBody",
                "text": "${data.message}"
              },
              {
                "type": "TextInput",
                "name": "amount",
                "label": "المبلغ بالجنيه",
                "required": true,
                "helper-text": "أرقام فقط"
              },
              {
                "type": "Footer",
                "label": "متابعة",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "recipient_phone": "${data.recipient_phone}",
                    "recipient_label": "${data.recipient_label}",
                    "amount": "${form.amount}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "REVIEW",
      "title": "مراجعة التحويل",
      "terminal": false,
      "data": {
        "authorization_id": {
          "type": "string",
          "__example__": "auth_xxx"
        },
        "recipient_label": {
          "type": "string",
          "__example__": "Ahmed (WTS-000123)"
        },
        "amount_label": {
          "type": "string",
          "__example__": "500 جنيه"
        },
        "fee_label": {
          "type": "string",
          "__example__": "1 جنيه"
        },
        "total_label": {
          "type": "string",
          "__example__": "501 جنيه"
        },
        "message": {
          "type": "string",
          "__example__": "راجع التحويل قبل تأكيده"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "review_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "مراجعة التحويل"
              },
              {
                "type": "TextBody",
                "text": "المستلم: ${data.recipient_label}\nالمبلغ: ${data.amount_label}\nالرسوم: ${data.fee_label}\nالإجمالي: ${data.total_label}"
              },
              {
                "type": "Footer",
                "label": "تأكيد",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "authorization_id": "${data.authorization_id}",
                    "recipient_label": "${data.recipient_label}",
                    "amount_label": "${data.amount_label}",
                    "fee_label": "${data.fee_label}",
                    "total_label": "${data.total_label}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PIN",
      "title": "الرمز السري",
      "terminal": false,
      "data": {
        "authorization_id": {
          "type": "string",
          "__example__": "auth_xxx"
        },
        "recipient_label": {
          "type": "string",
          "__example__": "Ahmed (WTS-000123)"
        },
        "amount_label": {
          "type": "string",
          "__example__": "500 جنيه"
        },
        "total_label": {
          "type": "string",
          "__example__": "501 جنيه"
        },
        "message": {
          "type": "string",
          "__example__": "أدخل رمز WTS السري المكوّن من 6 أرقام"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "pin_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "تأكيد التحويل"
              },
              {
                "type": "TextBody",
                "text": "${data.message}\nالإجمالي: ${data.total_label}"
              },
              {
                "type": "TextInput",
                "name": "pin",
                "label": "WTS PIN",
                "required": true,
                "helper-text": "6 أرقام"
              },
              {
                "type": "Footer",
                "label": "تنفيذ التحويل",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "authorization_id": "${data.authorization_id}",
                    "pin": "${form.pin}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "RESULT",
      "title": "النتيجة",
      "terminal": true,
      "data": {
        "success": {
          "type": "boolean",
          "__example__": true
        },
        "status": {
          "type": "string",
          "__example__": "SUCCESS"
        },
        "title": {
          "type": "string",
          "__example__": "✅ تمت العملية بنجاح"
        },
        "message": {
          "type": "string",
          "__example__": "تم التحويل بنجاح"
        },
        "transaction_id": {
          "type": "string",
          "__example__": ""
        },
        "amount_label": {
          "type": "string",
          "__example__": "500 جنيه"
        },
        "fee_label": {
          "type": "string",
          "__example__": "1 جنيه"
        },
        "total_label": {
          "type": "string",
          "__example__": "501 جنيه"
        },
        "balance_label": {
          "type": "string",
          "__example__": "1200 جنيه"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.title}"
          },
          {
            "type": "TextBody",
            "text": "${data.message}"
          },
          {
            "type": "TextBody",
            "text": "رقم العملية: ${data.transaction_id}"
          },
          {
            "type": "TextBody",
            "text": "المبلغ: ${data.amount_label}"
          },
          {
            "type": "TextBody",
            "text": "الرسوم: ${data.fee_label}"
          },
          {
            "type": "TextBody",
            "text": "الإجمالي: ${data.total_label}"
          },
          {
            "type": "TextBody",
            "text": "الرصيد: ${data.balance_label}"
          },
          {
            "type": "Footer",
            "label": "إغلاق",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}